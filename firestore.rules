rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if resource.data.active != false || isAdmin();
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if settingId == "shop";
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
    match /orders/{orderId} {
      allow read: if signedIn() &&
        (resource.data.customerId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }
  }
}
